{
  "name": "he-status-backend",
  "version": "1.0.0",
  "description": "Backend API for HE Status Page",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "db:reset": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "@he-status/shared": "*",
    "@node-saml/node-saml": "^5.1.0",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "openid-client": "^5.6.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.10.9",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
