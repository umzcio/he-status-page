# Database Configuration
DATABASE_URL=postgresql://hestatus:password@localhost:5432/hestatus
POSTGRES_USER=hestatus
POSTGRES_PASSWORD=password
POSTGRES_DB=hestatus

# Server Configuration
NODE_ENV=development
PORT=3000

# Number of reverse proxy hops in front of the backend (nginx, load balancers, etc).
# Used for Express's "trust proxy" setting so req.ip resolves the real client IP from
# X-Forwarded-For (affects rate limiting, logging, CORS). Increase if a load balancer
# sits in front of nginx. See: https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY_HOPS=1

# Set to "false" to disable the public API rate limiter (/api/services, /api/incidents),
# e.g. when an upstream load balancer already rate limits these endpoints.
# Does not affect authLimiter (login) or subscriptionLimiter (subscribe form).
RATE_LIMIT_PUBLIC_ENABLED=true

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Session cookies
# The admin session JWT is stored in an HttpOnly cookie (not localStorage), with
# a double-submit CSRF token. These control the cookie flags:
# COOKIE_SECURE: set "false" ONLY for local http dev; leave unset (or "true") in
# production behind TLS. Default: true when NODE_ENV=production, false otherwise.
COOKIE_SECURE=
# COOKIE_DOMAIN: optional. Leave unset for a host-only cookie (recommended for a
# single hostname). Set to a parent domain only if you need to share the session
# across subdomains.
COOKIE_DOMAIN=

# Poller Configuration
POLLER_INTERVAL_MINUTES=5
POLLER_ENABLED=true
# Allow status endpoints that resolve to private/loopback/link-local addresses (for monitoring internal services). Cloud metadata addresses are always blocked.
POLLER_ALLOW_PRIVATE_ENDPOINTS=false

# Microsoft 365 API
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Branding (shown in UI, emails, and page titles)
SITE_NAME="IT Status"
NEXT_PUBLIC_SITE_NAME="IT Status"
ORG_NAME="Example University"
NEXT_PUBLIC_ORG_NAME="Example University"
NEXT_PUBLIC_LOGO_PATH=/logo.svg
PRIMARY_COLOR=#1e40af
NEXT_PUBLIC_PRIMARY_COLOR=#1e40af

# Public URL (used in email templates and CAS service URL construction)
PUBLIC_URL=https://status.example.edu

# Base path the frontend is served under (leave empty to serve from the domain root)
NEXT_PUBLIC_BASE_PATH=

# URL (or reverse-proxy path prefix) the browser uses to reach the backend API.
# Empty = same origin. If a reverse proxy serves the app under a path prefix and
# routes "<prefix>/api" to the backend, set this to that prefix (e.g. /status).
NEXT_PUBLIC_API_URL=

# Email Service (SMTP)
SMTP_HOST=smtp.example.edu
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=status@example.edu
EMAIL_FROM_NAME="IT Status"

# LibreNMS API
LIBRENMS_URL=https://your-librenms-instance.example.com
LIBRENMS_API_TOKEN=

# Cloudflare Turnstile (subscribe-form spam prevention) — leave empty to disable.
# Create a widget at https://dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Frontend URL (used for CORS and CSP frame-ancestors)
FRONTEND_URL=http://localhost:3001

# CAS SSO Configuration (all optional; CAS is disabled if CAS_BASE_URL is unset)
CAS_BASE_URL=https://login.example.edu/cas
CAS_LOGOUT_URL=https://login.example.edu/cas/logout
CAS_EMAIL_DOMAIN=example.edu
CAS_SERVICE_URL=https://status.example.edu/api/admin/cas/callback

# Optional OIDC SSO — works with Entra ID, Okta, Google Workspace, Keycloak.
# Leave OIDC_ISSUER empty to disable. OIDC is enabled only when OIDC_ISSUER,
# OIDC_CLIENT_ID, and OIDC_CLIENT_SECRET are all set. Admin users must already
# exist in the DB with a matching (lowercased) email — SSO never creates users.
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${PUBLIC_URL}/api/admin/oidc/callback when unset.
OIDC_REDIRECT_URI=https://status.example.edu/api/admin/oidc/callback
OIDC_SCOPES=openid email profile

# Optional SAML 2.0 SSO — works with Shibboleth, ADFS, Entra ID (SAML), Okta,
# Keycloak, etc. SAML is DISABLED unless SAML_ENTRY_POINT, SAML_ISSUER, and an
# IdP certificate (SAML_IDP_CERT or SAML_IDP_CERT_FILE) are all set. Admin users
# must already exist in the DB with a matching (lowercased) email — SSO never
# creates users. SP metadata is served (once configured) at
# ${PUBLIC_URL}/api/admin/saml/metadata to ease IdP configuration.
#
# SAML_ENTRY_POINT — the IdP's SSO redirect URL.
SAML_ENTRY_POINT=https://idp.example.edu/idp/profile/SAML2/Redirect/SSO
# SAML_ISSUER — our SP entity ID (also the expected assertion audience).
SAML_ISSUER=https://status.example.edu/saml
# IdP signing certificate (PEM). Use SAML_IDP_CERT with literal \n escapes on a
# single line, OR point SAML_IDP_CERT_FILE at a PEM file (read at call time).
SAML_IDP_CERT=
# SAML_IDP_CERT_FILE=/etc/he-status/idp-cert.pem
# Defaults to ${PUBLIC_URL}/api/admin/saml/callback when unset.
SAML_CALLBACK_URL=https://status.example.edu/api/admin/saml/callback
# Optional: attribute name to read the email from. When unset, common email
# claim URIs are tried, then the NameID (if it looks like an email).
# SAML_EMAIL_ATTRIBUTE=email
# Optional single-logout URL.
# SAML_LOGOUT_URL=https://idp.example.edu/idp/profile/SAML2/Redirect/SLO
# Optional SP private key (PEM) to sign AuthnRequests (inline \n or file path).
# SAML_SP_PRIVATE_KEY=
# SAML_SP_PRIVATE_KEY_FILE=/etc/he-status/sp-key.pem

# Admin Configuration
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=changeme

# Docker Configuration
# DATABASE_URL is auto-set in docker-compose.yml from these values:
# POSTGRES_USER=hestatus
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=hestatus
